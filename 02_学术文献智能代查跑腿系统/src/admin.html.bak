<!DOCTYPE html>
<html lang="zh-CN" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>站长私密控制台 - 文献人工代查调度中心</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            apple: {
              bg: '#F5F5F7',
              ink: '#1D1D1F',
              sub: '#6E6E73'
            }
          },
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"PingFang SC"', 'sans-serif'],
            mono: ['"SF Mono"', 'Menlo', 'Monaco', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    * {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    body {
      background-color: #F5F5F7;
      color: #1D1D1F;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
    .apple-card {
      background: #FFFFFF;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 16px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
    }
    .btn-press:active {
      transform: scale(0.98);
      transition: transform 0.08s ease;
    }
  </style>
</head>
<body class="min-h-full flex flex-col font-sans pb-16">

  <!-- 登录拦截层 (未登录时显示) -->
  <div id="auth-gate" class="fixed inset-0 z-50 bg-[#F5F5F7] flex items-center justify-center p-4">
    <div class="apple-card max-w-sm w-full p-7 space-y-4 shadow-xl">
      <div class="text-center space-y-1">
        <div class="w-10 h-10 bg-black text-white rounded-xl flex items-center justify-center mx-auto mb-2">
          <i data-lucide="lock" class="w-5 h-5"></i>
        </div>
        <h2 class="text-base font-bold text-apple-ink">站长管理身份验证</h2>
        <p class="text-xs text-apple-sub">请输入站长专属管理口令进入控制台</p>
      </div>

      <div class="space-y-2">
        <input type="password" id="gate-password-input" placeholder="输入口令 (默认: admin888)" class="w-full text-xs px-3.5 py-2.5 bg-black/[0.03] border border-black/10 rounded-xl focus:border-black outline-none font-mono">
        <button onclick="checkAdminPassword()" class="w-full py-2.5 bg-black hover:bg-black/90 text-white text-xs font-bold rounded-xl btn-press">
          确认登录
        </button>
      </div>
      <div class="text-center text-[10px] text-apple-sub">默认安全口令：<code>admin888</code></div>
    </div>
  </div>

  <!-- 后台主界面 (验证通过后展示) -->
  <div id="admin-main" class="hidden">
    
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-black/[0.06]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <img src="assets/logo.jpg" alt="Logo" class="w-8 h-8 rounded-lg object-cover border border-black/10 shadow-sm">
          <div>
            <span class="text-sm font-black tracking-tight text-apple-ink">AAA人工文献库 · 站长调度中心</span>
          </div>
          <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800 font-bold flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span>
            实时接单中 (08:00 - 01:00)
          </span>
        </div>

        <div class="flex items-center space-x-3 text-xs">
          <!-- 来单铃声开关 -->
          <button onclick="toggleAudio()" id="btn-audio-toggle" class="px-2.5 py-1.5 rounded-lg border border-black/10 hover:bg-black/[0.04] text-apple-sub flex items-center">
            <i data-lucide="volume-2" id="icon-audio" class="w-3.5 h-3.5 mr-1 text-emerald-600"></i>
            <span id="txt-audio">来单声音: 开</span>
          </button>
          <a href="index.html" target="_blank" class="px-2.5 py-1.5 rounded-lg border border-black/10 hover:bg-black/[0.04] text-apple-ink font-medium flex items-center">
            <i data-lucide="external-link" class="w-3.5 h-3.5 mr-1"></i>
            查看客户前台
          </a>
          <button onclick="logoutAdmin()" class="text-apple-sub hover:text-black">
            <i data-lucide="log-out" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 space-y-6">
      
      <!-- 营收与数据大盘 (KPI) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="apple-card p-4 sm:p-5">
          <div class="text-xs text-apple-sub font-medium">今日预计营收</div>
          <div class="mt-1 flex items-baseline space-x-1">
            <span class="text-xs font-bold text-apple-ink">¥</span>
            <span id="stat-revenue-today" class="text-2xl sm:text-3xl font-black font-mono text-apple-ink tabular-nums">0.00</span>
          </div>
          <div class="mt-1 text-[11px] text-emerald-700">实时入账</div>
        </div>

        <div class="apple-card p-4 sm:p-5">
          <div class="text-xs text-apple-sub font-medium">待检索 / 待发货</div>
          <div class="mt-1 flex items-baseline space-x-1">
            <span id="stat-pending-count" class="text-2xl sm:text-3xl font-black font-mono text-amber-600 tabular-nums">0</span>
            <span class="text-xs text-apple-sub">单</span>
          </div>
          <div class="mt-1 text-[11px] text-amber-600">常规2h · 加急25min内交付</div>
        </div>

        <div class="apple-card p-4 sm:p-5">
          <div class="text-xs text-apple-sub font-medium">今日已交付</div>
          <div class="mt-1 flex items-baseline space-x-1">
            <span id="stat-done-count" class="text-2xl sm:text-3xl font-black font-mono text-emerald-600 tabular-nums">0</span>
            <span class="text-xs text-apple-sub">单</span>
          </div>
          <div class="mt-1 text-[11px] text-emerald-700">100% 高清原件发出</div>
        </div>

        <div class="apple-card p-4 sm:p-5">
          <div class="text-xs text-apple-sub font-medium">历史累计总单数</div>
          <div class="mt-1 flex items-baseline space-x-1">
            <span id="stat-total-count" class="text-2xl sm:text-3xl font-black font-mono text-apple-ink tabular-nums">0</span>
            <span class="text-xs text-apple-sub">单</span>
          </div>
          <div class="mt-1 text-[11px] text-apple-sub">
            历史总营收 ¥<span id="stat-revenue-total" class="font-mono font-bold">0.00</span>
          </div>
        </div>
      </div>

      <!-- 快捷学术搜索跳板 (方便站长一键直达) -->
      <div class="apple-card p-3.5 bg-black/[0.01] flex flex-wrap items-center justify-between gap-2 text-xs">
        <div class="text-apple-sub font-medium flex items-center">
          <i data-lucide="compass" class="w-3.5 h-3.5 mr-1.5 text-apple-ink"></i>
          <span>站长学术数据库快捷入口：</span>
        </div>
        <div class="flex flex-wrap gap-2 text-[11px]">
          <a href="https://scholar.google.com" target="_blank" class="px-2.5 py-1 rounded-md bg-white border border-black/10 hover:border-black/30 font-medium">Google Scholar 谷歌学术</a>
          <a href="https://www.sciencedirect.com" target="_blank" class="px-2.5 py-1 rounded-md bg-white border border-black/10 hover:border-black/30 font-medium">ScienceDirect (Elsevier)</a>
          <a href="https://ieeexplore.ieee.org" target="_blank" class="px-2.5 py-1 rounded-md bg-white border border-black/10 hover:border-black/30 font-medium">IEEE Xplore</a>
          <a href="https://www.cnki.net" target="_blank" class="px-2.5 py-1 rounded-md bg-white border border-black/10 hover:border-black/30 font-medium">中国知网 CNKI</a>
          <a href="http://www.nlc.cn" target="_blank" class="px-2.5 py-1 rounded-md bg-white border border-black/10 hover:border-black/30 font-medium">国家图书馆 (免费全库)</a>
        </div>
      </div>

            <!-- 服务授权激活码 (License Key) 卡密发卡中心 (正规订阅与发卡防逃单) -->
      <div class="apple-card p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-black/[0.06] pb-3">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-lg bg-black text-white flex items-center justify-center">
              <i data-lucide="key" class="w-4 h-4"></i>
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="text-sm font-bold text-apple-ink">授权激活码 (License Key) 发卡中心</h3>
                <span id="badge-keys-available" class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800">0 个可用</span>
              </div>
              <div class="text-[11px] text-apple-sub mt-0.5">系统已启用自动生成与直接核对激活码 · 专员在后台看到有人使用Key后，直接查好文献点击发送给他</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button onclick="generateNewKey('standard')" class="px-3 py-1.5 bg-black hover:bg-black/85 text-white text-xs font-bold rounded-lg btn-press flex items-center space-x-1 cursor-pointer">
              <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              <span>生成普通Key (2元)</span>
            </button>
            <button onclick="generateNewKey('urgent')" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg btn-press flex items-center space-x-1 cursor-pointer">
              <i data-lucide="zap" class="w-3.5 h-3.5"></i>
              <span>生成加急Key (4元)</span>
            </button>
            <button onclick="copyOneAvailableKey()" class="px-3 py-1.5 bg-white border border-black/10 hover:border-black/30 text-apple-ink text-xs font-bold rounded-lg btn-press flex items-center space-x-1 cursor-pointer">
              <i data-lucide="copy" class="w-3.5 h-3.5"></i>
              <span>复制1个可用Key发买家</span>
            </button>
          </div>
        </div>

        <!-- 激活码表格 -->
        <div class="overflow-x-auto max-h-56 overflow-y-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-black/[0.02] text-apple-sub font-mono sticky top-0 border-b border-black/[0.04]">
              <tr>
                <th class="px-3 py-2">授权激活码 (Key)</th>
                <th class="px-3 py-2">版本类型</th>
                <th class="px-3 py-2">核销状态</th>
                <th class="px-3 py-2">使用买家 / 关联工单</th>
                <th class="px-3 py-2 text-right">操作</th>
              </tr>
            </thead>
            <tbody id="keys-tbody" class="divide-y divide-black/[0.04]">
              <!-- 动态注入 -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- 实时代查工单队列 -->
      <div class="apple-card overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-black/[0.06] flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center space-x-2">
            <h3 class="text-sm font-bold text-apple-ink">实时工单列表</h3>
            <span class="text-xs px-2 py-0.5 rounded-full bg-black/[0.05] font-mono font-bold text-apple-ink" id="badge-total-orders">0</span>
          </div>

          <div class="flex items-center space-x-2 text-xs">
            <select id="filter-status-select" onchange="renderOrdersTable()" class="px-2.5 py-1.5 bg-black/[0.02] border border-black/10 rounded-lg text-apple-ink outline-none">
              <option value="all">全部工单状态</option>
              <option value="待处理">待处理</option>
              <option value="检索中">检索中</option>
              <option value="已发货">已发货</option>
              <option value="已退款">已退款</option>
            </select>
            <button onclick="exportCSV()" class="px-2.5 py-1.5 bg-white border border-black/10 rounded-lg hover:bg-black/[0.02] text-apple-ink font-medium flex items-center">
              <i data-lucide="download" class="w-3.5 h-3.5 mr-1"></i>
              导出CSV
            </button>
            <button onclick="clearCompletedOrders()" class="text-[11px] text-apple-sub hover:text-red-600 px-2">
              清空已发货
            </button>
          </div>
        </div>

        <!-- 表格 -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-apple-ink">
            <thead class="bg-black/[0.02] text-apple-sub uppercase font-mono tracking-wider border-b border-black/[0.06]">
              <tr>
                <th class="px-4 py-3">单号 / 时间</th>
                <th class="px-4 py-3">类型 / 财务核账</th>
                <th class="px-4 py-3 max-w-sm">文献需求内容 (DOI / 标题)</th>
                <th class="px-4 py-3">买家邮箱 / 联系方式</th>
                <th class="px-4 py-3">当前状态</th>
                <th class="px-4 py-3 text-right">财务核账与履约发货</th>
              </tr>
            </thead>
            <tbody id="orders-tbody" class="divide-y divide-black/[0.04]">
              <!-- 动态注入 -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- 邀请裂变返利管理面板 -->
      <div class="apple-card p-5 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <i data-lucide="gift" class="w-4 h-4 text-emerald-600"></i>
            <h3 class="text-sm font-bold text-apple-ink">邀请码裂变返利统计</h3>
          </div>
          <span class="text-xs text-apple-sub">记录哪个同学推荐了好友</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-black/[0.02] text-apple-sub font-mono border-b border-black/[0.04]">
              <tr>
                <th class="px-3 py-2">邀请码</th>
                <th class="px-3 py-2">所属同学邮箱</th>
                <th class="px-3 py-2">成功推荐单数</th>
                <th class="px-3 py-2">免费代查结余额度</th>
                <th class="px-3 py-2 text-right">操作</th>
              </tr>
            </thead>
            <tbody id="invites-tbody" class="divide-y divide-black/[0.04]">
              <!-- 动态注入 -->
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <!-- 新单桌面/网页气泡通知 -->
  <div id="toast-notify" class="fixed top-16 right-4 z-50 apple-card bg-white p-4 shadow-2xl max-w-sm border-l-4 border-emerald-500 hidden transition-all">
    <div class="flex items-start justify-between">
      <div class="flex items-center space-x-2">
        <i data-lucide="bell-ring" class="w-4 h-4 text-emerald-600 animate-bounce"></i>
        <span class="text-xs font-bold text-apple-ink">收到新文献代查工单！</span>
      </div>
      <button onclick="closeToast()" class="text-apple-sub hover:text-black text-xs">✕</button>
    </div>
    <div id="toast-text" class="mt-1.5 text-xs text-apple-sub line-clamp-2"></div>
  </div>

  <script>
    const STORAGE_KEY = 'academic_express_orders_v2';
    const INVITE_STORAGE_KEY = 'academic_express_invites_v2';
    let isAudioEnabled = true;

    const KEYS_STORAGE_KEY = 'academic_express_license_keys_v1';

    // 渲染激活码管理列表
    function renderLicenseKeysTable() {
      const keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      const tbody = document.getElementById('keys-tbody');
      const badgeAvail = document.getElementById('badge-keys-available');
      if (!tbody) return;

      const unusedCount = keys.filter(k => k.status === 'unused').length;
      if (badgeAvail) badgeAvail.innerText = `${unusedCount} 个待核销可用`;

      if (keys.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-3 py-4 text-center text-apple-sub">暂无激活码记录，点击上方按钮一键生成！</td></tr>';
        return;
      }

      let html = '';
      keys.forEach((k, idx) => {
        const isUsed = k.status === 'used';
        const typeBadge = k.type === 'urgent' ? 
          '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-700">🚨 25min加急码</span>' : 
          (k.type === 'free_trial' ? 
            '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-800">新客体验码</span>' : 
            '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-500/10 text-sky-800">标准2元码</span>'
          );
        const statusBadge = isUsed ? 
          '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-black/[0.05] text-apple-sub">已核销</span>' : 
          '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-800 animate-pulse">✓ 可用</span>';

        html += `
          <tr class="hover:bg-black/[0.01]">
            <td class="px-3 py-2 font-mono font-bold text-apple-ink select-all">${k.key}</td>
            <td class="px-3 py-2">${typeBadge}</td>
            <td class="px-3 py-2">${statusBadge}</td>
            <td class="px-3 py-2 text-apple-sub">
              ${isUsed ? `<span class="font-mono text-apple-ink font-bold">${k.usedByEmail || '已提单'}</span> (${k.orderId || ''})` : `<span class="text-black/30">待分配发放</span>`}
            </td>
            <td class="px-3 py-2 text-right space-x-1.5 whitespace-nowrap">
              ${!isUsed ? `<button onclick="copyTxt('${k.key}'); alert('已复制激活码【${k.key}】，直接发给微信买家或闲鱼即可！');" class="text-xs text-apple-ink font-bold hover:underline cursor-pointer">复制Key</button>` : ''}
              <button onclick="deleteKey('${k.key}')" class="text-[11px] text-apple-sub hover:text-red-600 px-1 cursor-pointer">删除</button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
      lucide.createIcons();
    }

    // 生成新的卡密激活码
    function generateNewKey(type) {
      const randStr = Math.random().toString(36).substring(2, 6).toUpperCase() + '-' + Math.random().toString(36).substring(2, 6).toUpperCase();
      const prefix = type === 'urgent' ? 'EXP-URGENT-' : 'EXP-KEY-';
      const newKeyStr = prefix + randStr;

      let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      keys.unshift({
        key: newKeyStr,
        type: type,
        status: 'unused',
        createdAt: new Date().toLocaleDateString()
      });
      localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));
      renderLicenseKeysTable();
      alert(`【授权激活码已生成！】\n\n代码：${newKeyStr}\n版本：${type === 'urgent' ? '25分钟极速加急码' : '标准代查码'}\n已复制到剪贴板，可直接发给买家！`);
      copyTxt(newKeyStr);
    }

    // 一键复制 1 个最新可用的 Key
    function copyOneAvailableKey() {
      const keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      const avail = keys.find(k => k.status === 'unused' && k.type !== 'free_trial');
      if (!avail) {
        if (confirm('当前没有可用的付费激活码了，是否立即生成一个新的标准激活码？')) {
          generateNewKey('standard');
        }
        return;
      }
      copyTxt(avail.key);
      alert(`【已复制可用激活码】\n\nKey：${avail.key}\n直接粘贴发送给买家即可！`);
    }

    // 删除 Key
    function deleteKey(keyStr) {
      if (confirm(`确认删除激活码 ${keyStr}？`)) {
        let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
        keys = keys.filter(k => k.key !== keyStr);
        localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));
        renderLicenseKeysTable();
      }
    }

    // 音频上下文 (Apple 风格轻柔“叮”一声)
    function playDingSound() {
      if (!isAudioEnabled) return;
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, audioCtx.currentTime); // A5
        osc.frequency.exponentialRampToValueAtTime(1760, audioCtx.currentTime + 0.15); // A6
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {}
    }

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      // 检查登录态
      if (sessionStorage.getItem('admin_logged_in') === 'true') {
        showAdmin();
      }

      // 监听跨标签页新订单
      window.addEventListener('storage', (e) => {
        if (e.key === 'latest_order_ping' && e.newValue) {
          try {
            const data = JSON.parse(e.newValue);
            handleNewIncomingOrder(data);
          } catch(err) {}
        }
      });
    });

    function checkAdminPassword() {
      const pwd = document.getElementById('gate-password-input').value.trim();
      if (pwd === 'admin888') {
        sessionStorage.setItem('admin_logged_in', 'true');
        showAdmin();
      } else {
        alert('管理口令错误！默认口令为 admin888');
      }
    }

    function showAdmin() {
      document.getElementById('auth-gate').classList.add('hidden');
      document.getElementById('admin-main').classList.remove('hidden');
      initDefaultOrdersIfEmpty();
      renderOrdersTable();
      renderLicenseKeysTable();
      renderInvitesTable();
      lucide.createIcons();
    }

    function logoutAdmin() {
      sessionStorage.removeItem('admin_logged_in');
      location.reload();
    }

    function toggleAudio() {
      isAudioEnabled = !isAudioEnabled;
      document.getElementById('txt-audio').innerText = isAudioEnabled ? '来单声音: 开' : '来单声音: 关';
      document.getElementById('icon-audio').className = isAudioEnabled ? 'w-3.5 h-3.5 mr-1 text-emerald-600' : 'w-3.5 h-3.5 mr-1 text-apple-sub';
    }

    function initDefaultOrdersIfEmpty() {
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      if (orders.length === 0) {
        const demo = [
          {
            id: 'EXP-20261026-8801',
            createdAt: '2026-10-26 18:15:30',
            serviceType: '精准代查 (英文外文)',
            content: '10.1016/j.cell.2023.08.012 (Cell 顶刊论文高清原件)',
            email: 'student_fudan@stu.edu.cn',
            wechat: 'wx_phd2026',
            amount: 0.00,
            status: '待处理',
            inviteCodeUsed: 'EXP888'
          },
          {
            id: 'EXP-20261026-9120',
            createdAt: '2026-10-26 18:22:15',
            serviceType: '关键词定制筛选代找 (英文+3年内+外籍+SCI顶刊1区)',
            content: '新能源汽车固态锂电池热失控机理与抑制手段，要求近3年内纯外籍作者顶刊。',
            email: 'researcher_tsinghua@tsinghua.edu.cn',
            wechat: '13900139000',
            amount: 7.00,
            status: '检索中',
            inviteCodeUsed: null
          }
        ];
        localStorage.setItem(STORAGE_KEY, JSON.stringify(demo));

        const demoInvites = {
          'EXP888': { ownerEmail: 'senior_scholar@stu.edu.cn', earnedCredits: 2, createdAt: '2026-10-26' }
        };
        localStorage.setItem(INVITE_STORAGE_KEY, JSON.stringify(demoInvites));
      }
    }

    function handleNewIncomingOrder(data) {
      playDingSound();
      const toast = document.getElementById('toast-notify');
      document.getElementById('toast-text').innerText = `买家: ${data.email} | 文献: ${data.content}`;
      toast.classList.remove('hidden');
      setTimeout(() => { toast.classList.add('hidden'); }, 6000);
      renderOrdersTable();
      renderLicenseKeysTable();
    }

    function closeToast() {
      document.getElementById('toast-notify').classList.add('hidden');
    }

    // 渲染工单列表
    function renderOrdersTable() {
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      const filter = document.getElementById('filter-status-select')?.value || 'all';

      let todayRev = 0;
      let totalRev = 0;
      let pendingCount = 0;
      let doneCount = 0;
      const todayStr = new Date().toISOString().slice(0, 10);

      orders.forEach(o => {
        totalRev += o.amount;
        if (o.createdAt.startsWith(todayStr)) todayRev += o.amount;
        if (o.status === '待处理' || o.status === '检索中') pendingCount++;
        if (o.status === '已发货') doneCount++;
      });

      document.getElementById('stat-revenue-today').innerText = todayRev.toFixed(2);
      document.getElementById('stat-revenue-total').innerText = totalRev.toFixed(2);
      document.getElementById('stat-pending-count').innerText = pendingCount;
      document.getElementById('stat-done-count').innerText = doneCount;
      document.getElementById('stat-total-count').innerText = orders.length;
      document.getElementById('badge-total-orders').innerText = `${orders.length} 单`;

      const tbody = document.getElementById('orders-tbody');
      const filtered = filter === 'all' ? orders : orders.filter(o => o.status === filter);

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-apple-sub text-xs">暂无工单记录</td></tr>`;
        return;
      }

      let html = '';
      filtered.forEach(o => {
        const badge = o.status === '已发货' ? 'bg-emerald-500/10 text-emerald-800' : (o.status === '检索中' ? 'bg-sky-500/10 text-sky-800' : (o.status === '已退款' ? 'bg-black/[0.05] text-apple-sub' : 'bg-amber-500/10 text-amber-900'));
        const isFree = o.amount === 0;
        const isFinanceConfirmed = (o.financeStatus === '已确认到账') || isFree;
        const payProofText = o.payProof || o.payerName || '已扫码付款';

        html += `
          <tr class="hover:bg-black/[0.01] transition-colors">
            <td class="px-4 py-3">
              <div class="flex items-center space-x-1.5">
                <span class="font-mono font-bold text-apple-ink">${o.id}</span>
                ${(o.isUrgent || (o.serviceType && o.serviceType.includes('25min'))) ? 
                  `<span class="inline-flex items-center text-[9px] px-1.5 py-0.2 rounded-full bg-rose-500/15 text-rose-700 font-bold border border-rose-300 animate-pulse">🚨 25min加急</span>` : ''}
              </div>
              <div class="text-[10px] text-apple-sub">${o.createdAt}</div>
              ${o.inviteCodeUsed ? `<span class="inline-block mt-0.5 text-[9px] px-1.5 py-0.2 rounded bg-purple-500/10 text-purple-800 font-mono">码: ${o.inviteCodeUsed}</span>` : ''}
            </td>
            <td class="px-4 py-3">
              <div class="font-medium text-apple-ink">${o.serviceType}</div>
              <div class="font-mono font-bold text-xs mt-0.5 ${isFree ? 'text-emerald-700' : 'text-apple-ink'}">
                ${isFree ? '¥0.00 (新客免单)' : `¥${o.amount.toFixed(2)}`}
              </div>
              <div class="mt-1 text-[10px]">
                ${isFree ? 
                  `<span class="bg-emerald-500/10 text-emerald-800 px-1.5 py-0.5 rounded font-bold">新客免单</span>` : 
                  (isFinanceConfirmed ? 
                    `<span class="bg-emerald-500/10 text-emerald-800 px-1.5 py-0.5 rounded font-bold">✓ 到账已核实 (${payProofText})</span>` : 
                    `<span class="bg-amber-500/15 text-amber-900 px-1.5 py-0.5 rounded font-bold animate-pulse">待核流水: ${payProofText}</span>`
                  )
                }
              </div>
            </td>
            <td class="px-4 py-3 max-w-sm">
              <div class="text-apple-ink font-medium select-all line-clamp-2" title="${o.content}">${o.content}</div>
              <div class="mt-1 flex items-center gap-2 text-[10px]">
                <button onclick="copyTxt('${escapeQuotes(o.content)}'); alert('已复制需求内容！');" class="text-apple-sub hover:text-black underline cursor-pointer">复制</button>
                <a href="https://scholar.google.com/scholar?q=${encodeURIComponent(o.content)}" target="_blank" class="text-blue-600 hover:underline">谷歌学术</a>
                <a href="https://www.cnki.net" target="_blank" class="text-blue-600 hover:underline">知网</a>
              </div>
            </td>
            <td class="px-4 py-3">
              <div class="font-mono font-bold text-apple-ink select-all">${o.email}</div>
              <div class="text-[10px] text-apple-sub">联系: ${o.wechat}</div>
            </td>
            <td class="px-4 py-3">
              <select onchange="changeStatus('${o.id}', this.value)" class="text-xs font-bold rounded-lg px-2 py-1 border border-black/10 outline-none cursor-pointer ${badge}">
                <option value="待处理" ${o.status==='待处理'?'selected':''}>待处理</option>
                <option value="检索中" ${o.status==='检索中'?'selected':''}>检索中</option>
                <option value="已发货" ${o.status==='已发货'?'selected':''}>已发货</option>
                <option value="已退款" ${o.status==='已退款'?'selected':''}>已退款</option>
              </select>
            </td>
            <td class="px-4 py-3 text-right space-x-1.5 whitespace-nowrap">
              ${(!isFinanceConfirmed && o.amount > 0) ? `
                <button onclick="confirmOrderPayment('${o.id}')" class="inline-flex items-center text-xs font-bold px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg shadow-sm btn-press cursor-pointer">
                  <i data-lucide="check" class="w-3.5 h-3.5 mr-1"></i> 确认到账并检索
                </button>
              ` : ''}
              <!-- 一键唤起发货邮件 (买家邮箱预填，专员拖入 PDF 原件发出) -->
              <a href="mailto:${o.email}?subject=【文献人工代查交付】官方正版高清原件 PDF 已随附件送达 (工单:${o.id})&body=同学你好，%0A%0A您申请代查的文献官方正版超清 PDF 原件已随本邮件附件发出，请查收！%0A文献内容：%0A${encodeURIComponent(o.content)}%0A%0A100% 官方正版高清原件，祝毕业论文与学术科研顺利！" onclick="markAsSent('${o.id}')" class="inline-flex items-center text-xs font-bold px-3 py-1.5 bg-black hover:bg-black/80 text-white rounded-lg shadow-sm btn-press cursor-pointer">
                <i data-lucide="mail" class="w-3.5 h-3.5 mr-1"></i> 直接发送给他 (附PDF)
              </a>
              <button onclick="removeOrder('${o.id}')" class="text-[11px] text-apple-sub hover:text-red-600 px-1 cursor-pointer">删除</button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
      lucide.createIcons();
    }

    function changeStatus(id, newStatus) {
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      const item = orders.find(o => o.id === id);
      if (item) {
        item.status = newStatus;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
        renderOrdersTable();
      renderLicenseKeysTable();
      }
    }

    function markAsSent(id) {
      setTimeout(() => {
        changeStatus(id, '已发货');
      }, 500);
    }

    // 站长财务核对：确认客户微信/支付宝已真实到账
    function confirmOrderPayment(id) {
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      const item = orders.find(o => o.id === id);
      if (item) {
        item.financeStatus = '已确认到账';
        if (item.status === '待处理') item.status = '检索中';
        localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
        renderOrdersTable();
      renderLicenseKeysTable();
        alert(`【工单 ${id} 款项已确认入账！】\n状态已更新为“检索中”，请在高校文献库下载正版原件后点击【直接发送给他 (附PDF)】发送给买家！`);
      }
    }

    function removeOrder(id) {
      if (confirm('确认删除此工单？')) {
        let orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        orders = orders.filter(o => o.id !== id);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
        renderOrdersTable();
      renderLicenseKeysTable();
      }
    }

    function clearCompletedOrders() {
      if (confirm('确认清空所有已发货的工单记录？')) {
        let orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        orders = orders.filter(o => o.status !== '已发货');
        localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));
        renderOrdersTable();
      renderLicenseKeysTable();
      }
    }

    // 渲染邀请裂变表
    function renderInvitesTable() {
      const invites = JSON.parse(localStorage.getItem(INVITE_STORAGE_KEY) || '{}');
      const tbody = document.getElementById('invites-tbody');
      const keys = Object.keys(invites);

      if (keys.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-3 py-4 text-center text-apple-sub text-xs">暂无邀请码记录</td></tr>`;
        return;
      }

      let html = '';
      keys.forEach(k => {
        const item = invites[k];
        html += `
          <tr class="hover:bg-black/[0.01]">
            <td class="px-3 py-2 font-mono font-bold text-apple-ink">${k}</td>
            <td class="px-3 py-2 font-mono text-apple-sub">${item.ownerEmail}</td>
            <td class="px-3 py-2 font-bold text-emerald-700">${item.earnedCredits || 0} 单</td>
            <td class="px-3 py-2 font-mono font-bold text-apple-ink">${item.earnedCredits || 0} 篇免费</td>
            <td class="px-3 py-2 text-right">
              <button onclick="deductCredit('${k}')" class="text-[10px] text-blue-600 hover:underline">核销1次</button>
            </td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    function deductCredit(code) {
      const invites = JSON.parse(localStorage.getItem(INVITE_STORAGE_KEY) || '{}');
      if (invites[code] && invites[code].earnedCredits > 0) {
        invites[code].earnedCredits -= 1;
        localStorage.setItem(INVITE_STORAGE_KEY, JSON.stringify(invites));
        renderInvitesTable();
        alert(`已成功为该同学核销 1 次免费代查！当前剩余：${invites[code].earnedCredits} 篇`);
      } else {
        alert('该邀请码已无结余免费额度。');
      }
    }

    function exportCSV() {
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      let csv = "\uFEFF单号,时间,类型,需求,邮箱,微信,实付,状态,邀请码\n";
      orders.forEach(o => {
        csv += `"${o.id}","${o.createdAt}","${o.serviceType}","${o.content.replace(/"/g, '""')}","${o.email}","${o.wechat}","${o.amount}","${o.status}","${o.inviteCodeUsed || ''}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `orders_${new Date().toISOString().slice(0,10)}.csv`;
      a.click();
    }

    function copyTxt(t) {
      if (navigator.clipboard) navigator.clipboard.writeText(t);
    }

    function escapeQuotes(s) {
      return (s || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }
  </script>
</body>
</html>
