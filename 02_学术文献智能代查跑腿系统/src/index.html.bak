            </div>

            <div id="lbl-kw-cn" onclick="selectKwLang('cn')" class="cursor-pointer border border-black/10 hover:border-black/20 p-3 rounded-xl flex items-center justify-between spring-card transition-all relative">
              <input type="radio" id="radio-kw-cn" name="kw_lang" value="cn" class="hidden">
              <div>
                <div class="text-xs font-bold text-apple-ink flex items-center gap-1.5">
                  <span>中文关键词代找</span>
                  <span id="tag-kw-cn" class="text-[9px] px-1.5 py-0.2 bg-black text-white rounded font-normal hidden">已选</span>
                </div>
                <div class="text-[11px] text-apple-sub">知网核心 / 学报 / 硕博精选</div>
              </div>
              <div class="text-right">
                <span class="font-mono text-base font-bold text-apple-ink">¥2.0</span>
                <span class="text-[10px] text-apple-sub">起/篇</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 篇数控制 -->
        <div class="flex items-center justify-between p-3 bg-black/[0.02] rounded-xl border border-black/[0.05]">
          <span class="text-xs font-medium text-apple-ink">需要筛选篇数：</span>
          <div class="flex items-center space-x-3">
            <button type="button" onclick="changeKwCount(-1)" class="w-7 h-7 rounded-lg bg-white border border-black/10 flex items-center justify-center font-bold text-apple-ink btn-press cursor-pointer">-</button>
            <span id="txt-kw-count" class="font-mono font-bold text-sm w-5 text-center">1</span>
            <button type="button" onclick="changeKwCount(1)" class="w-7 h-7 rounded-lg bg-white border border-black/10 flex items-center justify-center font-bold text-apple-ink btn-press cursor-pointer">+</button>
          </div>
        </div>

        <!-- 细化要求加价规则 -->
        <div class="space-y-2.5 p-3.5 bg-black/[0.02] rounded-xl border border-black/[0.05]">
          <div class="text-xs font-semibold text-apple-sub mb-1">附加筛选要求 (按需勾选，明码标价)</div>
          
          <!-- 年份 -->
          <div class="flex items-center justify-between text-xs py-1 border-b border-black/[0.04]">
            <span class="text-apple-ink font-medium">发表年份要求：</span>
            <div class="flex gap-1.5">
              <button type="button" onclick="selectKwYear('0')" id="opt-y-0" class="px-2.5 py-1 rounded-md bg-black text-white font-bold text-[11px] cursor-pointer shadow-sm spring-tab-transition">
                不限
              </button>
              <button type="button" onclick="selectKwYear('1')" id="opt-y-5" class="px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition">
                5年内 (+1元)
              </button>
              <button type="button" onclick="selectKwYear('1.5')" id="opt-y-3" class="px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition">
                3年内 (+1.5元)
              </button>
              <button type="button" onclick="selectKwYear('2')" id="opt-y-1" class="px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition">
                今年内 (+2元)
              </button>
            </div>
            <input type="hidden" id="val-kw-year" value="0">
          </div>

          <!-- 外国作者 -->
          <label class="flex items-center justify-between text-xs py-1.5 border-b border-black/[0.04] cursor-pointer">
            <div class="flex items-center space-x-2">
              <input type="checkbox" id="chk-foreign" onchange="calcPrice()" class="rounded border-black/20 text-black focus:ring-0">
              <span class="text-apple-ink font-medium">要求外籍作者发表 (满足外文引用规范)</span>
            </div>
            <span class="font-mono text-apple-sub">+¥1.5/篇</span>
          </label>

          <!-- 期刊级别 -->
          <div class="flex items-center justify-between text-xs py-1 border-b border-black/[0.04]">
            <span class="text-apple-ink font-medium">期刊影响级别：</span>
            <div class="flex gap-1.5">
              <button type="button" onclick="selectKwTier('0')" id="opt-t-0" class="px-2.5 py-1 rounded-md bg-black text-white font-bold text-[11px] cursor-pointer shadow-sm spring-tab-transition">
                常规学术期刊
              </button>
              <button type="button" onclick="selectKwTier('1')" id="opt-t-sci" class="px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition">
                SCI收录 (+1元)
              </button>
              <button type="button" onclick="selectKwTier('1.5')" id="opt-t-top" class="px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition">
                顶刊1区 (+1.5元)
              </button>
            </div>
            <input type="hidden" id="val-kw-tier" value="0">
          </div>

          <!-- 限制刊物 -->
          <label class="flex items-center justify-between text-xs py-1.5 cursor-pointer">
            <div class="flex items-center space-x-2">
              <input type="checkbox" id="chk-limit-journal" onchange="calcPrice()" class="rounded border-black/20 text-black focus:ring-0">
              <span class="text-apple-ink font-medium">限制在特定刊物范围内寻找</span>
            </div>
            <span class="font-mono text-apple-sub">+¥1/篇</span>
          </label>
        </div>

        <!-- 关键词输入 -->
        <div>
          <label for="input-kw-content" class="block text-xs font-semibold text-apple-sub mb-1.5">
