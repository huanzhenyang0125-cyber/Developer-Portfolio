          </label>
          <textarea id="input-kw-content" rows="3" placeholder="例如：锂电池热失控机理、多模态推荐系统。若对篇幅页数有特殊限制可一并备注..." class="w-full text-xs p-3 bg-black/[0.02] border border-black/10 rounded-xl focus:border-black focus:bg-white outline-none transition-all placeholder:text-apple-sub/50"></textarea>
        </div>
      </div>

      <!-- 第一步：客户学术身份核验 (解决刷新保护失效的根本利器，彻底杜绝免单白嫖) -->
      <div class="p-4 rounded-2xl bg-black/[0.02] border border-black/[0.08] space-y-3">
        <div class="flex items-center justify-between">
          <label for="input-email" class="text-xs font-bold text-apple-ink flex items-center">
            <i data-lucide="shield-check" class="w-4 h-4 mr-1.5 text-apple-ink"></i>
            <span>第一步：输入交付邮箱 · 验证学术身份</span>
            <span class="text-red-500 ml-1">*</span>
          </label>
          <span id="badge-auth-status" class="text-[10px] text-apple-sub font-mono bg-black/[0.05] px-2 py-0.5 rounded font-bold">待输入验证</span>
        </div>

        <div class="flex gap-2">
          <input type="email" id="input-email" oninput="onEmailInputTrigger()" placeholder="您的接收文献邮箱 (如QQ/网易/高校edu邮箱)" class="flex-grow text-xs px-3.5 py-2.5 bg-white border border-black/10 rounded-xl focus:border-black outline-none font-mono">
          <button type="button" onclick="verifyCustomerIdentity()" id="btn-verify-identity" class="px-4 py-2.5 bg-black hover:bg-black/85 text-white text-xs font-bold rounded-xl btn-press whitespace-nowrap cursor-pointer flex items-center space-x-1">
            <i data-lucide="check" class="w-3.5 h-3.5"></i>
            <span>核验身份</span>
          </button>
        </div>

        <!-- 身份核验结果通知卡片 (动态注入) -->
        <div id="auth-result-card" class="text-xs p-3 rounded-xl border border-black/[0.06] bg-white text-apple-sub flex items-start space-x-2">
          <i data-lucide="info" class="w-4 h-4 text-apple-sub flex-shrink-0 mt-0.5"></i>
          <span id="txt-auth-msg">请输入您的常用接收邮箱并点击【核验身份】。新同学立享首单免费，老同学按标准跑腿价计费。</span>
        </div>

        <!-- 联系方式选填 -->
        <div>
          <label for="input-wechat" class="block text-[11px] font-semibold text-apple-sub mb-1">
            微信或手机号 <span class="font-normal">(选填，仅用于疑难文献或紧急发货联络)</span>
          </label>
          <input type="text" id="input-wechat" placeholder="您的微信号或手机号" class="w-full text-xs px-3.5 py-2 bg-white border border-black/10 rounded-xl focus:border-black outline-none">
        </div>
      </div>

      <!-- 好友邀请码核销区 (双方各免1篇) -->
      <div class="space-y-2 pt-2 border-t border-black/[0.05]">
        <div class="flex gap-2">
          <input type="text" id="input-invite-code" placeholder="有好友专属 6 位邀请码？在此填写（双方各免1篇）" class="flex-grow text-xs px-3.5 py-2.5 bg-black/[0.02] border border-black/10 rounded-xl focus:border-black focus:bg-white outline-none uppercase font-mono">
          <button type="button" onclick="verifyInviteCode()" class="px-4 py-2.5 bg-black/[0.06] hover:bg-black/[0.1] text-apple-ink text-xs font-bold rounded-xl btn-press cursor-pointer">
