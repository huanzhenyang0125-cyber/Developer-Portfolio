        </div>
        <div id="invite-verify-tip" class="text-[11px] text-apple-sub hidden"></div>
      </div>

            <!-- 🚨 25分钟极速加急服务卡片 (搞笑幽默 · 怨种猫猫表情包配图) -->
      <div class="p-4 rounded-2xl border-2 border-black/10 hover:border-black/30 bg-white shadow-sm space-y-3 transition-all">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-start space-x-3">
            <input type="checkbox" id="chk-urgent" onchange="calcPrice()" class="mt-1 w-4 h-4 rounded border-black/30 text-black focus:ring-0 cursor-pointer">
            <div>
              <div class="flex items-center space-x-2">
                <label for="chk-urgent" class="text-xs font-bold text-apple-ink cursor-pointer flex items-center space-x-1">
