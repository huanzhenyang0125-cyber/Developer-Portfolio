  <!-- 页脚 (极简克制) -->
  <footer class="max-w-4xl mx-auto px-4 text-center text-xs text-apple-sub mt-8 space-y-1">
    <div>文献人工代查 · 纯人工检索 · 100% 正版高清原件</div>
    <div class="text-[10px] text-black/30">每日 08:00 - 凌晨 01:00 在线 · 下不到不收费</div>
  </footer>

  <!-- 弹窗 0：微信客服名片弹窗 (真实名片) -->
  <div id="modal-contact" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="apple-glass-card max-w-sm w-full p-6 space-y-4 shadow-xl text-center">
      <div class="flex items-center justify-between">
        <div class="text-sm font-bold text-apple-ink flex items-center">
          <i data-lucide="message-circle" class="w-4 h-4 mr-1.5 text-emerald-600"></i>
          <span>微信客服 · 看到信息秒回</span>
        </div>
        <button onclick="closeContactModal()" class="text-apple-sub hover:text-apple-ink">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <div class="w-52 h-64 mx-auto rounded-xl overflow-hidden border border-black/10 shadow-sm bg-white p-2">
        <img src="assets/wechat_contact.jpg" alt="微信客服二维码" class="w-full h-full object-contain rounded-lg">
      </div>

      <p class="text-xs text-apple-sub leading-relaxed">
        扫码添加专员微信好友：<span class="font-bold text-apple-ink font-mono">AAA人工文献库</span><br>
        如遇疑难绝版或加急，看到信息秒回！
      </p>
    </div>
  </div>

  <!-- 弹窗 1：分享裂变弹窗 (输入邮箱即生成 6 位专属邀请码) -->
  <div id="modal-share" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="apple-glass-card max-w-sm w-full p-6 space-y-4 shadow-xl">
      <div class="flex items-center justify-between">
        <div class="text-sm font-bold text-apple-ink flex items-center">
          <i data-lucide="gift" class="w-4 h-4 mr-1.5 text-emerald-600"></i>
          <span>邀请好友，双方各免 1 篇</span>
        </div>
        <button onclick="closeShareModal()" class="text-apple-sub hover:text-apple-ink">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <p class="text-xs text-apple-sub leading-relaxed">
        输入您的邮箱，生成您的专属邀请码。发给同学或舍友，好友凭码提单免首篇，您也免费多得 1 篇代查额度（中英文均可）！
      </p>

      <div class="space-y-2">
        <input type="email" id="share-my-email" placeholder="输入您的常用邮箱" class="w-full text-xs px-3.5 py-2.5 bg-black/[0.02] border border-black/10 rounded-xl focus:border-black outline-none font-mono">
        <button onclick="generateMyInviteCode()" class="w-full py-2.5 bg-black text-white text-xs font-bold rounded-xl btn-press">
          生成我的专属邀请码
        </button>
      </div>

      <!-- 生成后的展示卡片 -->
      <div id="share-code-box" class="hidden p-3.5 bg-black/[0.02] border border-black/10 rounded-xl space-y-2 text-xs">
        <div class="flex justify-between items-center">
          <span class="text-apple-sub">您的专属邀请码：</span>
          <span id="txt-generated-code" class="font-mono font-bold text-base text-apple-ink tracking-wider">EXP888</span>
        </div>
        <button onclick="copyInviteShareText()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg btn-press flex items-center justify-center space-x-1">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          <span>一键复制推荐文案给同学</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 弹窗 2：付款成功票据 Sheet (纯人工检索，2小时内直接发至邮箱) -->
  <div id="modal-receipt" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="apple-glass-card max-w-sm w-full p-6 sm:p-7 space-y-4 shadow-2xl text-center anim-spring-in relative">
      <!-- 右上角关闭 -->
      <button type="button" onclick="closeReceiptModal()" class="absolute top-4 right-4 text-apple-sub hover:text-apple-ink cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="w-12 h-12 rounded-full bg-emerald-500/10 text-emerald-600 flex items-center justify-center mx-auto shadow-sm">
        <i data-lucide="mail-check" class="w-6 h-6 stroke-[2.2]"></i>
      </div>

      <div>
        <div class="inline-flex items-center space-x-1.5 text-[11px] font-bold text-emerald-800 bg-emerald-500/10 px-2.5 py-0.5 rounded-full mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>工单已接单 · 专员正在高校图书馆下载</span>
        </div>
        <h3 class="text-base font-bold text-apple-ink">工单已收到，2小时内发您邮箱</h3>
        <p class="text-xs text-apple-sub mt-1 leading-relaxed">
          工单已直连推送至站长工作邮箱 (<span class="font-mono text-apple-ink font-bold">chinareferencehelper@gmail.com</span>)。专员已在工位检索，100% 官方正版超清 PDF 原件将作为邮件附件直接发送至您的邮箱！
        </p>
      </div>

      <!-- 交付信息卡片 -->
      <div class="p-3.5 bg-black/[0.02] border border-black/10 rounded-2xl text-xs space-y-2 text-left font-mono">
        <div class="flex justify-between">
          <span class="text-apple-sub">工单单号：</span>
          <span id="receipt-order-id" class="font-bold text-apple-ink select-all">EXP-...</span>
        </div>
        <div class="flex justify-between">
          <span class="text-apple-sub">交付邮箱：</span>
          <span id="receipt-email" class="font-bold text-apple-ink select-all">user@stu.edu.cn</span>
        </div>
        <div class="flex justify-between">
          <span class="text-apple-sub">实付金额：</span>
          <span id="receipt-amount" class="font-bold text-emerald-700">¥0.00</span>
        </div>
        <div class="flex justify-between" id="receipt-pay-proof-row">
          <span class="text-apple-sub">授权激活码：</span>
          <span id="receipt-pay-proof" class="font-bold text-apple-ink font-mono select-all">KEY-FREE-NEW</span>
        </div>
        <div class="flex justify-between pt-1 border-t border-black/[0.05] text-[11px] text-apple-sub font-sans">
          <span>交付方式：</span>
          <span class="font-bold text-apple-ink">官方正版超清原件 PDF 附件直发</span>
        </div>
      </div>

      <!-- 提示 -->
      <div class="text-[11px] text-apple-sub bg-emerald-500/[0.05] border border-emerald-500/20 p-2.5 rounded-xl leading-relaxed text-center">
        每日 08:00 – 凌晨 01:00 在线检索，2小时内发出。如遇疑难绝版或加急，请直接联系专员微信客服！
      </div>

      <!-- 底部操作按钮 -->
      <div class="space-y-2 pt-1">
        <button type="button" onclick="copyReceiptMemo()" class="w-full py-2.5 bg-black hover:bg-black/90 text-white text-xs font-bold rounded-xl btn-press cursor-pointer flex items-center justify-center space-x-1 shadow-sm">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i>
          <span>复制工单单号备忘</span>
        </button>
        <button type="button" onclick="closeReceiptModal()" class="w-full py-2 bg-black/[0.05] hover:bg-black/[0.08] text-apple-ink text-xs font-medium rounded-xl cursor-pointer">
          关闭，去邮箱等待查收
        </button>
      </div>
    </div>
  </div>

  <!-- 核心逻辑脚本 (纯前端逻辑，数据与私密控制台互通) -->
  <script>
    const STORAGE_KEY = 'academic_express_orders_v2';
    const INVITE_STORAGE_KEY = 'academic_express_invites_v2';
    const FREE_USED_DEVICE_KEY = 'academic_express_used_free_device_v2';
    const FREE_USED_EMAILS_KEY = 'academic_express_used_free_emails_v2';
    const KEYS_STORAGE_KEY = 'academic_express_license_keys_v1';

    let currentMode = 'doi'; // 'doi' 或 'keyword'
    let currentDoiLang = 'en'; // 'en' 或 'cn'
    let currentKwLang = 'en';  // 'en' 或 'cn'
    let doiCount = 1;
    let kwCount = 1;
    let currentPay = 'wechat';
    let validInviteCode = null;
    let verifiedCustomer = null; // 存储已通过核验的客户对象: { email: string, isFreeEligible: boolean }
    let currentVerifiedKey = null; // 存储当前核验通过的激活码对象

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      initLicenseKeysPool();
      // 初始化状态
      selectDoiLang('en');
      selectKwLang('en');
      selectKwYear('0');
      selectKwTier('0');

      // 页面加载或刷新时，重置核验状态为 null，强制保证初始为原价，彻底消除刷新变免费 bug
      resetCustomerVerification();
      autoGenerateNewKey(false);
      calcPrice();
    });

    // 初始化授权激活码池 (参考正规公司软件/订阅发卡机制)
    function initLicenseKeysPool() {
      let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      if (keys.length === 0) {
        const initialKeys = [
          { key: 'EXP-8891-AA12', type: 'standard', status: 'unused', createdAt: '系统初始' },
          { key: 'EXP-8892-BB34', type: 'standard', status: 'unused', createdAt: '系统初始' },
          { key: 'EXP-8893-CC56', type: 'standard', status: 'unused', createdAt: '系统初始' },
          { key: 'EXP-URGENT-991', type: 'urgent', status: 'unused', createdAt: '系统初始' },
          { key: 'EXP-URGENT-992', type: 'urgent', status: 'unused', createdAt: '系统初始' },
          { key: 'KEY-VIP-8888', type: 'any', status: 'unused', createdAt: '官方通用' }
        ];
        localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(initialKeys));
      }
    }

    // 免费资格防刷：检查设备是否用过
    function hasDeviceUsedFree() {
      return localStorage.getItem(FREE_USED_DEVICE_KEY) === 'true';
    }

    // 免费资格防刷：检查邮箱是否用过
    function hasEmailUsedFree(email) {
      if (!email) return false;
      const cleanEmail = email.trim().toLowerCase();
      const usedEmails = JSON.parse(localStorage.getItem(FREE_USED_EMAILS_KEY) || '[]');
      if (usedEmails.includes(cleanEmail)) return true;
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      return orders.some(o => o.email && o.email.toLowerCase() === cleanEmail && (o.amount === 0 || o.isFreeUsed));
    }

// 自动为客户生成并直接核对专属激活码 (彻底摆脱人工客服)
    function autoGenerateNewKey(forceNew = false) {
      const input = document.getElementById('input-license-key');
      const badge = document.getElementById('badge-key-status');
      const chkUrgent = document.getElementById('chk-urgent');
      const isUrgent = Boolean(chkUrgent && chkUrgent.checked);

      if (!forceNew && input && input.value.trim() && currentVerifiedKey) {
        return currentVerifiedKey;
      }

      const prefix = isUrgent ? 'URGENT-KEY-' : 'KEY-EXP-';
      const randPart = Math.floor(1000 + Math.random() * 9000) + '-' + Math.random().toString(36).substring(2, 6).toUpperCase();
      const generatedKeyStr = prefix + randPart;

      let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      const keyObj = {
        key: generatedKeyStr,
        type: isUrgent ? 'urgent' : 'standard',
        status: 'unused',
        createdAt: '系统自动分配'
      };
      keys.push(keyObj);
      localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));

      currentVerifiedKey = keyObj;

      if (input) input.value = generatedKeyStr;
      if (badge) {
        badge.innerText = '✓ 专属Key已自动就绪';
        badge.className = 'text-[10px] font-mono text-emerald-800 bg-emerald-500/15 px-2 py-0.5 rounded font-bold';
      }

      return keyObj;
    }

    // Key 输入框手动变动时触发
    function onKeyInputTrigger() {
      const input = document.getElementById('input-license-key');
      const val = input ? input.value.trim().toUpperCase() : '';
      const badge = document.getElementById('badge-key-status');
      if (currentVerifiedKey && currentVerifiedKey.key.toUpperCase() === val) {
        return;
      }
      currentVerifiedKey = null;
      if (badge) {
        badge.innerText = '待直接核对Key';
        badge.className = 'text-[10px] font-mono text-amber-700 bg-amber-500/10 px-2 py-0.5 rounded font-bold';
      }
    }

    // 直接核对激活码 (自动极速校验，无需联系任何客服)
    function verifyLicenseKey() {
      const input = document.getElementById('input-license-key');
      let keyStr = input ? input.value.trim().toUpperCase() : '';
      const badge = document.getElementById('badge-key-status');
      const msg = document.getElementById('txt-key-msg');

      if (!keyStr) {
        // 如果为空，直接自动生成并绑定
        const autoKey = autoGenerateNewKey(true);
        keyStr = autoKey.key;
      }

      let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
      let found = keys.find(k => k.key.toUpperCase() === keyStr);

      if (!found) {
        // 自动注册并接纳该激活码，直接核对通过
        found = { key: keyStr, type: 'standard', status: 'unused', createdAt: '实时自动校验' };
        keys.push(found);
        localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));
      }

      if (found.status === 'used') {
        alert(`【激活码已核销】

该激活码已于 ${found.usedAt || '此前'} 被工单 ${found.orderId || ''} 核销使用！
系统将立即为您自动换发一个新的专属 Key！`);
        const brandNew = autoGenerateNewKey(true);
        alert(`【新专属激活码已自动生成并核验通过！】

全新 Key：${brandNew.key}
无需联系客服，请直接点击下方提单！`);
        return;
      }

      currentVerifiedKey = found;
      if (badge) {
        badge.innerText = '✓ Key已直接核对通过';
        badge.className = 'text-[10px] font-mono text-emerald-800 bg-emerald-500/20 px-2 py-0.5 rounded font-bold';
      }
      if (msg) {
        msg.innerHTML = `<span class="text-emerald-800 font-bold">🎉 专属激活码 [${currentVerifiedKey.key}] 已直接核对通过！</span> 扫码付款后点击下方提交，专员后台看到后将直接发送文献到您的邮箱！`;
      }
      alert(`【激活码直接核对通过！】

专属 Key：[${currentVerifiedKey.key}]
系统已完成绑定。无需找客服，扫码付款后直接点击提单，专员将在后台直接给您发邮箱！`);
    }

    // 重置身份核验状态 (输入框变动或初始化时触发)
    function resetCustomerVerification() {
      verifiedCustomer = null;
      const badge = document.getElementById('badge-auth-status');
      const msg = document.getElementById('txt-auth-msg');
      const card = document.getElementById('auth-result-card');
      if (badge) {
        badge.innerText = '待输入验证';
        badge.className = 'text-[10px] text-apple-sub font-mono bg-black/[0.05] px-2 py-0.5 rounded font-bold';
      }
      if (msg) {
        msg.innerText = '请输入您的常用接收邮箱并点击【核验身份】。新同学立享首单免费，老同学按标准跑腿价计费。';
      }
      if (card) {
        card.className = 'text-xs p-3 rounded-xl border border-black/[0.06] bg-white text-apple-sub flex items-start space-x-2';
      }
    }

    // 客户修改邮箱时的实时触发器
    function onEmailInputTrigger() {
      resetCustomerVerification();
      calcPrice();
    }

    // 执行学术身份核验 (核心防刷防刷新利器)
    function verifyCustomerIdentity() {
      const input = document.getElementById('input-email');
      const email = input ? input.value.trim().toLowerCase() : '';
      if (!email || !email.includes('@')) {
        alert('【请输入有效交付邮箱】\n\n请在输入框中填写您用于接收正版文献 PDF 的真实邮箱 (如 QQ/网易/高校 edu 邮箱)！');
        if (input) input.focus();
        return;
      }

      const isDeviceUsed = hasDeviceUsedFree();
      const isEmailUsed = hasEmailUsedFree(email);
      const isAlreadyUsed = isDeviceUsed || isEmailUsed;

      const badge = document.getElementById('badge-auth-status');
      const msg = document.getElementById('txt-auth-msg');
      const card = document.getElementById('auth-result-card');

      if (isAlreadyUsed) {
        // 老同学 / 曾享受过免单
        verifiedCustomer = { email: email, isFreeEligible: false };
        if (badge) {
          badge.innerText = '老同学已核验';
          badge.className = 'text-[10px] text-apple-ink font-mono bg-black/[0.08] px-2 py-0.5 rounded font-bold';
        }
        if (msg) {
          msg.innerText = '👤 身份核验通过：老同学欢迎回归！系统检测到您此前已体验过新客首单免单，本次按标准超低跑腿价结算。感谢支持高校兼职跑腿！';
        }
        if (card) {
          card.className = 'text-xs p-3 rounded-xl border border-black/10 bg-black/[0.02] text-apple-ink flex items-start space-x-2';
        }
      } else {
        // 真正的新客首单
        verifiedCustomer = { email: email, isFreeEligible: true };
        if (badge) {
          badge.innerText = '🎉 新客免单已激活';
          badge.className = 'text-[10px] text-emerald-800 font-mono bg-emerald-500/20 px-2 py-0.5 rounded font-bold';
        }
        if (msg) {
          msg.innerText = '🎉 身份核验通过：恭喜新同学！新客福利已激活，系统已为您自动绑定专属免单激活码！官方正版原件查到后直发您的邮箱。';
        }
        if (card) {
          card.className = 'text-xs p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/[0.06] text-emerald-900 flex items-start space-x-2';
        }

        // 自动发放新客体验 Key
        const freeKeyStr = 'FREE-NEW-' + Math.floor(1000 + Math.random() * 9000);
        const freeKeyObj = { key: freeKeyStr, type: 'free_trial', status: 'unused', createdAt: '新客体验' };
        let keys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
        keys.push(freeKeyObj);
        localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(keys));
        currentVerifiedKey = freeKeyObj;

        const inputKey = document.getElementById('input-license-key');
        if (inputKey) inputKey.value = freeKeyStr;
        const badgeKey = document.getElementById('badge-key-status');
        if (badgeKey) {
          badgeKey.innerText = '✓ 免单Key已自动绑定';
          badgeKey.className = 'text-[10px] font-mono text-emerald-800 bg-emerald-500/20 px-2 py-0.5 rounded font-bold';
        }
        const msgKey = document.getElementById('txt-key-msg');
        if (msgKey) msgKey.innerHTML = `<span class="text-emerald-800 font-bold">🎁 新客免单激活码 [${freeKeyStr}] 已自动绑定！</span> 本单无需扫码付款，直接点击下方提交即可！`;
      }

      calcPrice();
      lucide.createIcons();
    }

    // 模式切换
    function switchMode(mode) {
      currentMode = mode;
      const tabDoi = document.getElementById('tab-doi');
      const tabKw = document.getElementById('tab-kw');
      const secDoi = document.getElementById('section-mode-doi');
      const secKw = document.getElementById('section-mode-kw');

      if (!tabDoi || !tabKw || !secDoi || !secKw) return;

      secDoi.classList.remove('anim-spring-in');
      secKw.classList.remove('anim-spring-in');

      if (mode === 'doi') {
        tabDoi.className = "py-2.5 px-3 rounded-xl bg-black text-white shadow-sm spring-tab-transition spring-press flex items-center justify-center space-x-1.5 font-bold cursor-pointer";
        tabKw.className = "py-2.5 px-3 rounded-xl text-apple-sub hover:text-apple-ink spring-tab-transition spring-press flex items-center justify-center space-x-1.5 font-medium cursor-pointer";
        secDoi.classList.remove('hidden');
        void secDoi.offsetWidth;
        secDoi.classList.add('anim-spring-in');
        secKw.classList.add('hidden');
      } else {
        tabKw.className = "py-2.5 px-3 rounded-xl bg-black text-white shadow-sm spring-tab-transition spring-press flex items-center justify-center space-x-1.5 font-bold cursor-pointer";
        tabDoi.className = "py-2.5 px-3 rounded-xl text-apple-sub hover:text-apple-ink spring-tab-transition spring-press flex items-center justify-center space-x-1.5 font-medium cursor-pointer";
        secKw.classList.remove('hidden');
        void secKw.offsetWidth;
        secKw.classList.add('anim-spring-in');
        secDoi.classList.add('hidden');
      }
      calcPrice();
      lucide.createIcons();
    }

    // 精准代查语种选择 (英文2元，中文1元)
    function selectDoiLang(lang) {
      currentDoiLang = lang;
      const radioEn = document.getElementById('radio-doi-en');
      const radioCn = document.getElementById('radio-doi-cn');
      const lblEn = document.getElementById('lbl-doi-en');
      const lblCn = document.getElementById('lbl-doi-cn');
      const tagEn = document.getElementById('tag-doi-en');
      const tagCn = document.getElementById('tag-doi-cn');
      const badgeHint = document.getElementById('badge-doi-lang-hint');

      if (lang === 'en') {
        if (radioEn) radioEn.checked = true;
        if (lblEn) lblEn.className = "cursor-pointer border-2 border-black bg-black/[0.03] p-3 rounded-xl flex items-center justify-between spring-card shadow-sm transition-all relative";
        if (lblCn) lblCn.className = "cursor-pointer border border-black/10 hover:border-black/20 p-3 rounded-xl flex items-center justify-between spring-card transition-all relative";
        if (tagEn) tagEn.classList.remove('hidden');
        if (tagCn) tagCn.classList.add('hidden');
        if (badgeHint) badgeHint.innerText = "当前已选：英文 2元/篇";
      } else {
        if (radioCn) radioCn.checked = true;
        if (lblCn) lblCn.className = "cursor-pointer border-2 border-black bg-black/[0.03] p-3 rounded-xl flex items-center justify-between spring-card shadow-sm transition-all relative";
        if (lblEn) lblEn.className = "cursor-pointer border border-black/10 hover:border-black/20 p-3 rounded-xl flex items-center justify-between spring-card transition-all relative";
        if (tagCn) tagCn.classList.remove('hidden');
        if (tagEn) tagEn.classList.add('hidden');
        if (badgeHint) badgeHint.innerText = "当前已选：中文 1元/篇";
      }
      calcPrice();
    }

    // 关键词代找语种选择 (英文3元起，中文2元起)
    function selectKwLang(lang) {
      currentKwLang = lang;
      const radioEn = document.getElementById('radio-kw-en');
      const radioCn = document.getElementById('radio-kw-cn');
      const lblEn = document.getElementById('lbl-kw-en');
      const lblCn = document.getElementById('lbl-kw-cn');
      const tagEn = document.getElementById('tag-kw-en');
      const tagCn = document.getElementById('tag-kw-cn');
      const badgeHint = document.getElementById('badge-kw-lang-hint');

      if (lang === 'en') {
        if (radioEn) radioEn.checked = true;
        if (lblEn) lblEn.className = "cursor-pointer border-2 border-black bg-black/[0.03] p-3 rounded-xl flex items-center justify-between spring-card shadow-sm transition-all relative";
        if (lblCn) lblCn.className = "cursor-pointer border border-black/10 hover:border-black/20 p-3 rounded-xl flex items-center justify-between spring-card transition-all relative";
        if (tagEn) tagEn.classList.remove('hidden');
        if (tagCn) tagCn.classList.add('hidden');
        if (badgeHint) badgeHint.innerText = "当前已选：英文 3元起/篇";
      } else {
        if (radioCn) radioCn.checked = true;
        if (lblCn) lblCn.className = "cursor-pointer border-2 border-black bg-black/[0.03] p-3 rounded-xl flex items-center justify-between spring-card shadow-sm transition-all relative";
        if (lblEn) lblEn.className = "cursor-pointer border border-black/10 hover:border-black/20 p-3 rounded-xl flex items-center justify-between spring-card transition-all relative";
        if (tagCn) tagCn.classList.remove('hidden');
        if (tagEn) tagEn.classList.add('hidden');
        if (badgeHint) badgeHint.innerText = "当前已选：中文 2元起/篇";
      }
      calcPrice();
    }

    // 关键词代找发表年份单选
    function selectKwYear(val) {
      const inputVal = document.getElementById('val-kw-year');
      if (inputVal) inputVal.value = val;
      const map = { '0': 'opt-y-0', '1': 'opt-y-5', '1.5': 'opt-y-3', '2': 'opt-y-1' };
      Object.keys(map).forEach(k => {
        const btn = document.getElementById(map[k]);
        if (btn) {
          if (k === val) {
            btn.className = "px-2.5 py-1 rounded-md bg-black text-white font-bold text-[11px] cursor-pointer shadow-sm spring-tab-transition";
          } else {
            btn.className = "px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition";
          }
        }
      });
      calcPrice();
    }

    // 关键词代找期刊级别单选
    function selectKwTier(val) {
      const inputVal = document.getElementById('val-kw-tier');
      if (inputVal) inputVal.value = val;
      const map = { '0': 'opt-t-0', '1': 'opt-t-sci', '1.5': 'opt-t-top' };
      Object.keys(map).forEach(k => {
        const btn = document.getElementById(map[k]);
        if (btn) {
          if (k === val) {
            btn.className = "px-2.5 py-1 rounded-md bg-black text-white font-bold text-[11px] cursor-pointer shadow-sm spring-tab-transition";
          } else {
            btn.className = "px-2.5 py-1 rounded-md bg-black/[0.04] text-apple-ink font-medium text-[11px] cursor-pointer hover:bg-black/[0.08] spring-tab-transition";
          }
        }
      });
      calcPrice();
    }

    function changeDoiCount(d) {
      doiCount = Math.max(1, doiCount + d);
      const el = document.getElementById('txt-doi-count');
      if (el) el.innerText = doiCount;
      calcPrice();
    }

    function changeKwCount(d) {
      kwCount = Math.max(1, kwCount + d);
      const el = document.getElementById('txt-kw-count');
      if (el) el.innerText = kwCount;
      calcPrice();
    }

    // 核心价格计算 (默认标准跑腿价，加急+2元，身份核验通过新客才抵扣)
    function calcPrice() {
      let unitPrice = 0;
      let count = 1;
      let itemTitle = '';

      if (currentMode === 'doi') {
        const isEn = (currentDoiLang === 'en');
        unitPrice = isEn ? 2.0 : 1.0;
        count = doiCount;
        itemTitle = isEn ? '精准代查 (英文外文文献)' : '精准代查 (中文学术文献)';
      } else {
        const isEn = (currentKwLang === 'en');
        const base = isEn ? 3.0 : 2.0;
        const yearPlus = parseFloat(document.getElementById('val-kw-year')?.value || '0');
        const foreignPlus = document.getElementById('chk-foreign')?.checked ? 1.5 : 0;
        const tierPlus = parseFloat(document.getElementById('val-kw-tier')?.value || '0');
        const limitJournalPlus = document.getElementById('chk-limit-journal')?.checked ? 1.0 : 0;

        unitPrice = base + yearPlus + foreignPlus + tierPlus + limitJournalPlus;
        count = kwCount;
        itemTitle = isEn ? '关键词代找 (英文方向精筛)' : '关键词代找 (中文方向精筛)';
      }

      // 基础文献费用
      const itemSubtotal = unitPrice * count;

      // 加急服务费用 (+2.00)
      const chkUrgent = document.getElementById('chk-urgent');
      const isUrgent = Boolean(chkUrgent && chkUrgent.checked);
      const urgentFee = isUrgent ? 2.0 : 0.0;

      const subtotal = itemSubtotal + urgentFee;
      let discount = 0;

      // 只有在已通过身份核验且确认具备新客免单资格时，才享受第 1 篇文献立减 (加急跑腿费不免)
      const isFreeEligible = (verifiedCustomer && verifiedCustomer.isFreeEligible === true);
      if (isFreeEligible) {
        discount += unitPrice;
      }

      // 邀请码额外免减 1 篇基础文献费
      if (validInviteCode) {
        discount += unitPrice;
      }

      const finalTotal = Math.max(0, subtotal - discount);

      // 更新结算文本
      const elItemTitle = document.getElementById('txt-calc-item-title');
      const elItemMath = document.getElementById('txt-calc-item-math');
      const elUrgentRow = document.getElementById('box-urgent-row');
      const elDiscountRow = document.getElementById('box-discount-row');
      const elDiscount = document.getElementById('txt-calc-discount');
      const elFinalPrice = document.getElementById('txt-final-price');

      if (elItemTitle) elItemTitle.innerText = itemTitle;
      if (elItemMath) elItemMath.innerText = `¥${unitPrice.toFixed(2)} × ${count}篇 = ¥${itemSubtotal.toFixed(2)}`;

      // 自动联动加急激活码
      if (isUrgent && currentVerifiedKey && !currentVerifiedKey.key.startsWith('URGENT-KEY-')) {
        autoGenerateNewKey(true);
      } else if (!isUrgent && currentVerifiedKey && currentVerifiedKey.key.startsWith('URGENT-KEY-')) {
        autoGenerateNewKey(true);
      }

      // 加急行显隐联动
      if (elUrgentRow) {
        if (isUrgent) {
          elUrgentRow.classList.remove('hidden');
        } else {
          elUrgentRow.classList.add('hidden');
        }
      }

      // 折扣行显隐联动
      if (elDiscountRow && elDiscount) {
        if (discount > 0) {
          elDiscountRow.classList.remove('hidden');
          elDiscount.innerText = `-¥${discount.toFixed(2)}`;
        } else {
          elDiscountRow.classList.add('hidden');
        }
      }

      if (elFinalPrice) elFinalPrice.innerText = finalTotal.toFixed(2);

      // 联动控制【付款区域】与【提单按钮】：未付款前必须展示付款码与凭证输入框
      const boxLicenseKey = document.getElementById('box-license-key');
      const boxQr = document.getElementById('box-qr-wrapper');
      const tipQr = document.getElementById('tip-pay-qr');
      const submitBtnText = document.getElementById('txt-submit-btn');

      const timeNotice = isUrgent ? '🚨 25分钟极速发邮箱 (超时免单)' : '2小时内发邮箱';

      if (finalTotal <= 0) {
        // 免单状态
        // 保持激活码卡片可见以便核验免单Key
        if (boxQr) boxQr.classList.add('opacity-40');
        if (tipQr) tipQr.innerText = '🎁 当前已激活新客免费特权，本单无需扫码付款，直接提交即可！';
        if (submitBtnText) submitBtnText.innerText = `提交新客免费工单 (${timeNotice})`;
      } else {
        // 需付款状态：先付后查，严禁逃单
        if (boxLicenseKey) boxLicenseKey.classList.remove('hidden');
        if (boxQr) boxQr.classList.remove('opacity-40');
        if (tipQr) tipQr.innerText = '手机端可截屏或长按保存后扫码付款 · 扫码付款后输入付款凭证提交即可';
        if (submitBtnText) submitBtnText.innerText = `我已扫码付款 ¥${finalTotal.toFixed(2)}，提交工单 (${timeNotice})`;
      }
    }

    // 切换收款码
    function setPayMethod(m) {
      currentPay = m;
      const btnWx = document.getElementById('btn-pay-wx');
      const btnAli = document.getElementById('btn-pay-ali');
      const img = document.getElementById('img-pay-qr');

      if (!btnWx || !btnAli || !img) return;

      if (m === 'wechat') {
        btnWx.className = "px-3 py-1.5 rounded-lg bg-black text-white shadow-sm spring-tab-transition spring-press font-bold cursor-pointer";
        btnAli.className = "px-3 py-1.5 rounded-lg text-apple-sub hover:text-black spring-tab-transition spring-press font-medium cursor-pointer";
        img.src = "assets/wechat_pay.jpg";
      } else {
        btnAli.className = "px-3 py-1.5 rounded-lg bg-black text-white shadow-sm spring-tab-transition spring-press font-bold cursor-pointer";
        btnWx.className = "px-3 py-1.5 rounded-lg text-apple-sub hover:text-black spring-tab-transition spring-press font-medium cursor-pointer";
        img.src = "assets/alipay_pay.jpg";
      }
    }

    // 验证好友 6 位邀请码
    function verifyInviteCode() {
      const input = document.getElementById('input-invite-code');
      const code = input ? input.value.trim().toUpperCase() : '';
      const tip = document.getElementById('invite-verify-tip');
      if (!tip) return;
      tip.classList.remove('hidden');

      if (!code || code.length !== 6) {
        tip.innerHTML = '<span class="text-rose-600">请输入完整的 6 位好友邀请码</span>';
        return;
      }

      validInviteCode = code;
      tip.innerHTML = `<span class="text-emerald-700 font-bold">✓ 6位专属邀请码 ${code} 验证成功！已额外免减 1 篇文献</span>`;
      calcPrice();
    }

    // 提交订单 (核心：严格身份核验 + 先付款后提单 + 财务到账核对凭证 + 人工发邮箱，绝无网盘)
    function submitClientOrder() {
      const emailInput = document.getElementById('input-email');
      const email = emailInput ? emailInput.value.trim().toLowerCase() : '';

      // 1. 拦截未核验身份或邮箱变动未重新核验
      if (!email || !email.includes('@')) {
        alert('【请先填写有效邮箱】\n\n请在第一步输入用于接收文献的邮箱地址！');
        if (emailInput) emailInput.focus();
        return;
      }

      if (!verifiedCustomer || verifiedCustomer.email.toLowerCase() !== email) {
        alert('【请先点击核验身份】\n\n为了保障学术专属权益与防刷机制，请先点击第一步中的【核验身份】黑色按钮！\n完成核验后方可提交工单。');
        const verifyBtn = document.getElementById('btn-verify-identity');
        if (verifyBtn) verifyBtn.focus();
        return;
      }

      // 2. 检查输入内容合规性
      let content = '';
      let serviceTitle = '';
      if (currentMode === 'doi') {
        content = document.getElementById('input-doi-content').value.trim();
        if (!content) {
          alert('请填写需要代查的文献 DOI 或官方链接！');
          document.getElementById('input-doi-content').focus();
          return;
        }

        const isDoiOrUrl = content.includes('10.') || content.toLowerCase().includes('http') || content.toLowerCase().includes('doi.org');
        if (!isDoiOrUrl) {
          alert('【精准代查只收 DOI 或官方链接】\n\n检测到您输入的不是有效的文献 DOI（如 10.1016/...）或官方论文直达链接！\n\n为了保证 100% 查到正版原件且避免找错扯皮，精准代查模式只接受输入 DOI 或官方文章链接。\n\n如果您手上只有文章题目或研究方向，请点击上方切换到【关键词代找】模式提交哦！');
          document.getElementById('input-doi-content').focus();
          return;
        }

        const isEn = (currentDoiLang === 'en');
        serviceTitle = isEn ? '精准代查 (英文外文 DOI)' : '精准代查 (中文学术 DOI)';
      } else {
        content = document.getElementById('input-kw-content').value.trim();
        if (!content) {
          alert('请填写研究方向或核心关键词！');
          document.getElementById('input-kw-content').focus();
          return;
        }
        const isEn = (currentKwLang === 'en');
        serviceTitle = isEn ? '关键词代找 (英文方向定制)' : '关键词代找 (中文方向定制)';
      }

      const amount = parseFloat(document.getElementById('txt-final-price').innerText);

      // 3. 激活码处理与防刷校验
      const inputKeyEl = document.getElementById('input-license-key');
      let enteredKey = inputKeyEl ? inputKeyEl.value.trim().toUpperCase() : '';

      if (amount > 0) {
        // 需付款订单：自动确保拥有已核对的专属激活码
        if (!enteredKey) {
          const autoK = autoGenerateNewKey(true);
          enteredKey = autoK.key;
        }
        if (!currentVerifiedKey || currentVerifiedKey.key.toUpperCase() !== enteredKey) {
          currentVerifiedKey = {
            key: enteredKey,
            type: isUrgent ? 'urgent' : 'standard',
            status: 'unused',
            createdAt: '提交时自动直接核对'
          };
        }
      } else {
        // 免单订单 (amount === 0)：二次防刷安全锁
        if (hasDeviceUsedFree() || hasEmailUsedFree(email)) {
          alert('【新客免单限享受 1 次】\n\n系统检测到您的邮箱或设备此前已享受过免费试用，无法重复免单。\n请重新核验身份并按标准超低跑腿价扫码付款，感谢同学支持！');
          verifyCustomerIdentity();
          return;
        }
      }

      const wechat = document.getElementById('input-wechat').value.trim() || '未填';
      const activeKeyStr = currentVerifiedKey ? currentVerifiedKey.key : (enteredKey || '新客免单Key');
      const payerName = amount > 0 ? `${currentPay === 'wechat' ? '微信支付' : '支付宝'} [Key: ${activeKeyStr}]` : `新客免单 [${activeKeyStr}]`;

      // 4. 生成订单号与时间
      const now = new Date();
      const dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');
      const rand = Math.floor(1000 + Math.random() * 9000);
      const orderId = `EXP-${dateStr}-${rand}`;
      const timeStr = now.getFullYear() + '-' + 
                      String(now.getMonth()+1).padStart(2, '0') + '-' + 
                      String(now.getDate()).padStart(2, '0') + ' ' + 
                      String(now.getHours()).padStart(2, '0') + ':' + 
                      String(now.getMinutes()).padStart(2, '0');

      const isThisOrderFreeUsed = (amount === 0 && !validInviteCode);
      const chkUrgent = document.getElementById('chk-urgent');
      const isUrgent = Boolean(chkUrgent && chkUrgent.checked);

      const newOrder = {
        id: orderId,
        createdAt: timeStr,
        serviceType: serviceTitle + (isUrgent ? ' 【🚨25min极速加急】' : ''),
        content: content,
        email: email,
        wechat: wechat,
        amount: amount,
        paymentMethod: amount > 0 ? (currentPay === 'wechat' ? '微信支付' : '支付宝') : '新客免单',
        payerName: payerName,
        payProof: activeKeyStr,
        financeStatus: amount > 0 ? '待财务核对' : '免单已核准',
        status: '待检索', // 待检索 / 检索中 / 已发货
        isUrgent: isUrgent,
        isFreeUsed: isThisOrderFreeUsed,
        inviteCodeUsed: validInviteCode || null
      };

      // 5. 写入存储 (与管理后台 admin.html 互通)
      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      orders.unshift(newOrder);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(orders));

      // 若使用了首单免费，永久记录该邮箱和当前设备，绝无二次白嫖可能
      if (isThisOrderFreeUsed) {
        localStorage.setItem(FREE_USED_DEVICE_KEY, 'true');
        const usedEmails = JSON.parse(localStorage.getItem(FREE_USED_EMAILS_KEY) || '[]');
        if (!usedEmails.includes(email.toLowerCase())) {
          usedEmails.push(email.toLowerCase());
          localStorage.setItem(FREE_USED_EMAILS_KEY, JSON.stringify(usedEmails));
        }
        if (verifiedCustomer) verifiedCustomer.isFreeEligible = false;
      }

      // 累计邀请人额度
      if (validInviteCode) {
        const invites = JSON.parse(localStorage.getItem(INVITE_STORAGE_KEY) || '{}');
        if (invites[validInviteCode]) {
          invites[validInviteCode].earnedCredits = (invites[validInviteCode].earnedCredits || 0) + 1;
          localStorage.setItem(INVITE_STORAGE_KEY, JSON.stringify(invites));
        }
      }

      // 真正的卡密核销机制 (一码一单，核销后永久作废)
      if (currentVerifiedKey) {
        let allKeys = JSON.parse(localStorage.getItem(KEYS_STORAGE_KEY) || '[]');
        let kObj = allKeys.find(k => k.key.toUpperCase() === currentVerifiedKey.key.toUpperCase());
        if (kObj) {
          kObj.status = 'used';
          kObj.usedAt = timeStr;
          kObj.usedByEmail = email;
          kObj.orderId = orderId;
        } else {
          allKeys.push({
            key: currentVerifiedKey.key,
            type: isUrgent ? 'urgent' : 'standard',
            status: 'used',
            usedAt: timeStr,
            usedByEmail: email,
            orderId: orderId,
            createdAt: '动态核销'
          });
        }
        localStorage.setItem(KEYS_STORAGE_KEY, JSON.stringify(allKeys));
        currentVerifiedKey = null;
      }

      // 6. 直连推送工单至站长 Gmail chinareferencehelper@gmail.com
      notifyAdminViaMail(newOrder);

      // 7. 弹出工单确认 Sheet (纯人工直接发邮箱承诺，绝无任何网盘和外部 link)
      showOrderReceiptModal(newOrder);

      // 8. 清空文献输入框与凭据输入框，恢复标准状态
      if (currentMode === 'doi') {
        document.getElementById('input-doi-content').value = '';
      } else {
        document.getElementById('input-kw-content').value = '';
      }
      const inputKeyClear = document.getElementById('input-license-key');
      if (inputKeyClear) inputKeyClear.value = '';
      onKeyInputTrigger();

      // 提单后老客自动锁定原价
      verifyCustomerIdentity();
    }

    // 弹出工单收条弹窗 (承诺人工直发邮箱，无任何下载链接)
    function showOrderReceiptModal(order) {
      document.getElementById('receipt-order-id').innerText = order.id;
      document.getElementById('receipt-email').innerText = order.email;
      document.getElementById('receipt-amount').innerText = `¥${order.amount.toFixed(2)}`;
      
      const proofEl = document.getElementById('receipt-pay-proof');
      if (proofEl) proofEl.innerText = order.payerName;

      document.getElementById('modal-receipt').classList.remove('hidden');
      lucide.createIcons();
    }

    // 关闭工单收条
    function closeReceiptModal() {
      document.getElementById('modal-receipt').classList.add('hidden');
    }

    // 复制工单备忘
    function copyReceiptMemo() {
      const id = document.getElementById('receipt-order-id')?.innerText || '';
      const em = document.getElementById('receipt-email')?.innerText || '';
      const amt = document.getElementById('receipt-amount')?.innerText || '';
      const proof = document.getElementById('receipt-pay-proof')?.innerText || '';
      copyText(`【文献代查工单备忘】\n单号：${id}\n交付邮箱：${em}\n实付金额：${amt}\n付款核验：${proof}\n服务承诺：高校专员正在全权限官方库人工检索，100% 官方正版超清 PDF 原件将在 2 小时内直接发送到您的邮箱附件。`);
      alert('工单单号与交付备忘已成功复制！');
    }

    // 客户自查进度 (纯人工直发邮箱展示，绝无下载通道按钮)
    function queryOrderStatus() {
      const q = document.getElementById('query-email-input').value.trim().toLowerCase();
      const box = document.getElementById('query-result-box');
      if (!q) {
        alert('请输入提单时的邮箱或工单单号！');
        return;
      }

      const orders = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      const matched = orders.filter(o => (o.email && o.email.toLowerCase() === q) || (o.id && o.id.toLowerCase() === q));

      box.classList.remove('hidden');
      if (matched.length === 0) {
        box.innerHTML = `<div class="p-3 bg-black/[0.02] border border-black/10 rounded-xl text-center text-xs text-apple-sub">未找到与该邮箱或单号相关的工单，请检查是否填写正确。</div>`;
      } else {
        let html = '';
        matched.forEach(o => {
          let badgeClass = 'bg-amber-500/10 text-amber-900';
          let statusText = o.status || '待处理';
          const isOrderUrgent = o.isUrgent || (o.serviceType && o.serviceType.includes('25min'));
          let deliverNotice = isOrderUrgent ? 
            `🚨 <span class="font-bold text-rose-600">25分钟极速加急中</span>：专员已火速开启高校库检索，无论此前在洗澡、干饭还是看电影均已中断优先处理！承诺 25 分钟内正版原件直接发送至您的邮箱：<span class="font-mono font-bold text-apple-ink">${o.email}</span>，超时一秒不收钱直接全额退款！` :
            `专员正在海外高校全权限官方库检索，100% 正版超清原件 PDF 将于 2 小时内直接作为附件发送至您的邮箱：<span class="font-mono font-bold text-apple-ink">${o.email}</span>`;

          if (o.status === '已发货') {
            badgeClass = 'bg-emerald-500/10 text-emerald-800';
            statusText = '已发货至邮箱';
            deliverNotice = `✓ 100% 官方正版超清原件 PDF 已成功发送至您的邮箱：<span class="font-mono font-bold text-apple-ink">${o.email}</span>，请登录邮箱查看附件（如未收到可检查垃圾箱或联系客服微信）。`;
          } else if (o.status === '检索中') {
            badgeClass = 'bg-sky-500/10 text-sky-800';
            statusText = '专员检索下载中';
          }

          html += `
            <div class="p-4 bg-black/[0.02] border border-black/10 rounded-2xl text-xs space-y-2.5">
              <div class="flex justify-between items-center">
                <span class="font-mono font-bold text-apple-ink text-sm">${o.id}</span>
                <span class="px-2.5 py-0.5 rounded-full font-bold text-[11px] ${badgeClass}">${statusText}</span>
              </div>
              <div class="text-apple-sub leading-relaxed"><span class="text-black/40 font-semibold">需求：</span>${o.content}</div>
              <div class="p-2.5 bg-white rounded-xl border border-black/[0.06] text-[11px] text-apple-sub leading-relaxed">
                ${deliverNotice}
              </div>
              <div class="text-[11px] text-apple-sub pt-2 border-t border-black/[0.04] flex items-center justify-between">
                <span>实付金额：¥${o.amount.toFixed(2)} (${o.payerName || '已扫码付款'})</span>
                <span class="font-mono text-[10px] text-apple-sub">${o.createdAt}</span>
              </div>
            </div>
          `;
        });
        box.innerHTML = html;
        lucide.createIcons();
      }
    }

    // 订单直连发送至站长工作邮箱 (chinareferencehelper@gmail.com)
    function notifyAdminViaMail(order) {
      // 1. 本地广播唤醒后台控制台
      try {
        localStorage.setItem('latest_order_ping', JSON.stringify({
          time: Date.now(),
          orderId: order.id,
          email: order.email,
          content: order.content,
          payer: order.payerName,
          amount: order.amount
        }));
      } catch (e) {}

      // 2. 通过 Webhook 将真实邮件推送至站长 Gmail
      const loadingTip = document.getElementById('submit-loading-tip');
      if (loadingTip) loadingTip.classList.remove('hidden');

      const urgentSubject = order.isUrgent ? '【🚨25MIN加急!洗澡吃饭看电影已中断】' : '';
      const mailData = {
        _subject: `${urgentSubject}【新文献代查工单到账】单号:${order.id} | 实付:¥${order.amount} | 付款凭证:${order.payerName}`,
        加急状态: order.isUrgent ? '🚨 25分钟内必须发至邮箱！超时不收钱全额退款！专员速查！' : '常规订单 (2小时内发邮箱)',
        工单单号: order.id,
        服务类型: order.serviceType,
        文献需求: order.content,
        买家邮箱: order.email,
        微信手机: order.wechat,
        实付金额: `¥${order.amount.toFixed(2)}`,
        付款凭据: order.payerName,
        到账审核: order.amount > 0 ? '请专员核对微信/支付宝转账记录' : '新客免单',
        发货提示: '请下载高清原件后直接邮件回复附件给买家',
        提单时间: order.createdAt
      };

      fetch('https://formsubmit.co/ajax/chinareferencehelper@gmail.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(mailData)
      })
      .then(res => res.json())
      .then(data => {
        console.log('Gmail push result:', data);
      })
      .catch(err => {
        console.log('Gmail push error:', err);
      })
      .finally(() => {
        if (loadingTip) loadingTip.classList.add('hidden');
      });
    }

    function scrollToTrack() {
      document.getElementById('section-track').scrollIntoView({ behavior: 'smooth' });
    }

    // 邀请裂变弹窗
    function openShareModal() {
      document.getElementById('modal-share').classList.remove('hidden');
    }
    function closeShareModal() {
      document.getElementById('modal-share').classList.add('hidden');
    }

    // 客服名片弹窗
    function openContactModal() {
      document.getElementById('modal-contact').classList.remove('hidden');
    }
    function closeContactModal() {
      document.getElementById('modal-contact').classList.add('hidden');
    }

    // 生成严格 6 位纯数字邀请码
    function generateMyInviteCode() {
      const email = document.getElementById('share-my-email').value.trim();
      if (!email || !email.includes('@')) {
        alert('请先输入您的有效邮箱！');
        return;
      }

      let hash = 0;
      for (let i = 0; i < email.length; i++) hash = ((hash << 5) - hash) + email.charCodeAt(i);
      const code = String(Math.abs(hash % 900000 + 100000));

      const invites = JSON.parse(localStorage.getItem(INVITE_STORAGE_KEY) || '{}');
      if (!invites[code]) {
        invites[code] = { ownerEmail: email, earnedCredits: 0, createdAt: new Date().toLocaleDateString() };
        localStorage.setItem(INVITE_STORAGE_KEY, JSON.stringify(invites));
      }

      document.getElementById('txt-generated-code').innerText = code;
      document.getElementById('share-code-box').classList.remove('hidden');
    }

    function copyInviteShareText() {
      const code = document.getElementById('txt-generated-code').innerText;
      const text = `同学，这个外文文献人工代查很靠谱，100% 官方正版超清 PDF 原件，2 小时内发邮箱！\n输入我的邀请码【${code}】首篇直接免费试用：${window.location.href}`;
      copyText(text);
      alert('推荐文案已复制！快发给班级群或舍友吧！');
    }

    function copyText(txt) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(txt);
      } else {
        const t = document.createElement("textarea");
        t.value = txt;
        document.body.appendChild(t);
        t.select();
        document.execCommand("copy");
        document.body.removeChild(t);
      }
    }
  </script>
</body>
</html>
